# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Zapier / webhook forwarding (optional, preserved from previous build)
SCORECARD_WEBHOOK_URL=
SCORECARD_RESULTS_WEBHOOK_URL=
SCORECARD_EVENT_WEBHOOK_URL=

# Supabase funnel logging — the "Content" project.
# SUPABASE_URL is the project REST base, e.g. https://oiivbwvjhlrzjcphchtk.supabase.co
# SUPABASE_SERVICE_ROLE_KEY is the service role secret (server-side only; never NEXT_PUBLIC).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Agency CRM
# ---------------------------------------------------------------------------
# The CRM uses the same Supabase project as the funnel tables above. The anon
# key is safe in the browser — Row Level Security is what protects the data.
# The service role key is NOT: it bypasses RLS entirely. Keep it out of any
# NEXT_PUBLIC_ variable, and never reference it from a client component.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shared secret for POST /api/crm/sync-leads. Leave blank to keep that route
# disabled; it refuses every request until this is set.
#   openssl rand -hex 32
LEAD_SYNC_SECRET=

# ---------------------------------------------------------------------------
# Google Calendar (optional)
# ---------------------------------------------------------------------------
# Leave blank and the CRM keeps appointments to itself — the calendar page says
# so rather than looking broken. Set them and each user can connect their own
# Google account from /calendar.
#
# Create an OAuth client (type: Web application) at console.cloud.google.com,
# enable the Google Calendar API, and add the callback below as an authorised
# redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Derived from the request origin when blank, which is what preview
# deployments need; set it when the Google console has one fixed URI.
GOOGLE_REDIRECT_URI=

# Encrypts OAuth tokens before they are written to the database, so a Postgres
# backup on its own is not a set of live Google credentials. Required to
# connect a calendar at all.
#   openssl rand -base64 32
# Changing this makes every stored token unreadable and every calendar has to
# be reconnected.
CALENDAR_TOKEN_KEY=

# Shared secret for POST /api/crm/calendar/sync, so a scheduler can sync every
# connected account. Blank leaves scheduled syncing disabled; the in-app
# "Sync now" button works either way.
#   openssl rand -hex 32
CALENDAR_SYNC_SECRET=

# Enables Google push notifications, so changes made in Google appear here
# promptly instead of at the next poll. Optional: the sync converges without
# it.
#   openssl rand -hex 32
CALENDAR_WEBHOOK_SECRET=
# The public URL Google should call. Must be reachable from the internet and
# HTTPS, so localhost cannot use this.
#   https://crm.youragency.com/api/crm/calendar/webhook
CALENDAR_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Stripe (optional)
# ---------------------------------------------------------------------------
# Leave blank and the CRM records no billing — the payments page says so rather
# than looking broken. Set them and invoices and retainers can be raised from a
# client's page.
#
# Use a test key (sk_test_…) until you mean it. The payments page shows which
# mode is in use.
STRIPE_SECRET_KEY=

# From the Stripe dashboard → Developers → Webhooks, after adding an endpoint
# pointing at https://<your-host>/api/crm/stripe/webhook
#
# Without this NOTHING EVER MOVES TO PAID. The frontend cannot set payment
# status — the database has no write policy on `payments` for any role — so the
# webhook is the only thing that can, by design.
#
# Subscribe the endpoint to at least:
#   invoice.created, invoice.finalized, invoice.sent, invoice.paid,
#   invoice.payment_failed, invoice.marked_uncollectible, invoice.voided,
#   customer.subscription.created, customer.subscription.updated,
#   customer.subscription.deleted, charge.refunded
STRIPE_WEBHOOK_SECRET=

# Currency invoices are raised in, lower-case. Defaults to gbp.
STRIPE_CURRENCY=gbp
