# ---------------------------------------------------------------------------
# lead_pipeline configuration. Copy to .env and fill in what you have.
# EVERY key is optional - the pipeline runs with none of them (OpenStreetMap
# discovery + website analysis), and each source reports itself unavailable
# when its key is missing. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Identify yourself (required by the OSM/Nominatim usage policy) --------
CONTACT_EMAIL=you@youragency.co.uk
# Default is "LeadPipeline/1.0 (your@email)". Override only if you need to;
# keep it short - long agents carrying a URL can trip WAF rules and get you a
# blanket 403/406 from some hosts.
# USER_AGENT=LeadPipeline/1.0 (you@youragency.co.uk)

# --- Discovery sources -----------------------------------------------------
# Google Maps Platform key with the Places API (New) enabled.
GOOGLE_PLACES_API_KEY=
# Bing Maps key (Local Search API).
BING_MAPS_API_KEY=

# --- Search / SERP (any ONE enables the `search` source) -------------------
# SerpAPI additionally enables *confirmed* Google Ads detection (paid results).
SERPAPI_API_KEY=
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# --- Enrichment ------------------------------------------------------------
# Companies House public API key (UK registry: legal name, number, incorporation date).
COMPANIES_HOUSE_API_KEY=
# Meta Ad Library API token - enables *confirmed* Meta ads detection where the
# Ad Library covers the market.
META_AD_LIBRARY_TOKEN=
# PageSpeed Insights API key - replaces the heuristic speed estimate with a
# real Lighthouse mobile performance score.
PAGESPEED_API_KEY=

# --- Politeness / crawling -------------------------------------------------
RESPECT_ROBOTS=true
DEFAULT_RATE_PER_SECOND=1.0
PER_HOST_CONCURRENCY=2
GLOBAL_CONCURRENCY=12
REQUEST_TIMEOUT=20
CONNECT_TIMEOUT=10
MAX_RETRIES=3
BACKOFF_BASE=0.5
BACKOFF_MAX=30
MAX_PAGES_PER_SITE=6
# Per-host overrides, comma separated: host:requests_per_second
# HOST_RATE_OVERRIDES=overpass-api.de:0.5,nominatim.openstreetmap.org:1.0

# --- Caching / storage -----------------------------------------------------
CACHE_ENABLED=true
CACHE_DIR=.lead_pipeline_cache
CACHE_TTL_SECONDS=604800
DB_PATH=leads.sqlite
OUTPUT_DIR=output

# --- Scoring / qualification ----------------------------------------------
MIN_SCORE=60
RECHECK_DAYS=14
DEFAULT_RADIUS_KM=25
DEFAULT_COUNTRY=UK

# Data-protection default: named-individual email addresses (e.g. j.smith@)
# are collected but excluded from outreach. Set to true only where you have a
# lawful basis for contacting a named person at a business.
ALLOW_NAMED_CONTACT_EMAILS=false

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
# LOG_FILE=logs/pipeline.jsonl

# --- Config file overrides -------------------------------------------------
# NICHES_PATH=lead_pipeline/config/niches.json
# WEIGHTS_PATH=lead_pipeline/config/scoring_weights.json
# DIRECTORIES_PATH=lead_pipeline/config/directories.json

# Overpass endpoint. overpass-api.de is often overloaded; official mirrors:
#   https://overpass.kumi.systems/api/interpreter
#   https://overpass.private.coffee/api/interpreter
# Leave commented to use the default (overpass-api.de). Uncomment ONE line only -
# a duplicate key later in this file silently overrides an earlier one.
# OVERPASS_URL=https://overpass.kumi.systems/api/interpreter
# OVERPASS_URL=https://overpass.private.coffee/api/interpreter
