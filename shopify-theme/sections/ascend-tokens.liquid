{%- comment -%}
  ASCEND — Design tokens
  Emits the palette as CSS custom properties on :root plus shared component
  styles (CTA button, editor placeholder banner). Keep this section FIRST in
  index.json. Tune the whole page's tone from this one section's settings.

  Every other section reads these via var(--ascend-*, fallback) so the page
  still renders sanely if this section is ever removed.
{%- endcomment -%}

{%- style -%}
  :root {
    /* --- Surfaces (heavy/dark early in the arc) --- */
    --ascend-bg: {{ section.settings.bg | default: '#0B0D10' }};
    --ascend-bg-2: {{ section.settings.bg_2 | default: '#101319' }};
    --ascend-surface: {{ section.settings.surface | default: '#161A20' }};

    /* --- Surfaces (clean/calm from the Solution section onward) --- */
    --ascend-surface-light: {{ section.settings.surface_light | default: '#F5F7F9' }};
    --ascend-surface-light-2: #E9EDF1;

    /* --- Text --- */
    --ascend-ink: {{ section.settings.ink | default: '#EDF0F3' }};
    --ascend-ink-dark: {{ section.settings.ink_dark | default: '#111820' }};
    --ascend-body: {{ section.settings.body | default: '#C4CAD3' }};
    --ascend-body-dark: #3A434E;
    --ascend-muted: {{ section.settings.muted | default: '#8C94A0' }};

    /* --- Signal colours --- */
    --ascend-loss: {{ section.settings.loss | default: '#C85248' }};
    --ascend-accent: {{ section.settings.accent | default: '#34B98C' }};
    --ascend-accent-ink: #08120E;
    --ascend-focus: {{ section.settings.focus | default: '#6FB0FF' }};

    /* --- Lines & shadow --- */
    --ascend-line: rgba(255,255,255,0.09);
    --ascend-line-dark: rgba(17,24,32,0.12);
    --ascend-shadow: 0 1px 0 rgba(255,255,255,0.03), 0 24px 60px -30px rgba(0,0,0,0.7);

    /* --- Type --- */
    --ascend-sans: {{ section.settings.font_sans | default: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif' }};
    --ascend-serif: {{ section.settings.font_serif | default: 'Georgia, "Iowan Old Style", "Times New Roman", serif' }};

    /* --- Rhythm --- */
    --ascend-maxw: 720px;
    --ascend-maxw-wide: 1040px;
    --ascend-radius: 12px;
    --ascend-pad-block: clamp(3.5rem, 9vw, 7rem);
    --ascend-pad-inline: clamp(1.25rem, 5vw, 2rem);
  }

  /* ---------- Shared primitives ---------- */
  .ascend-section { font-family: var(--ascend-sans); -webkit-font-smoothing: antialiased; }
  .ascend-section * { box-sizing: border-box; }
  .ascend-wrap {
    max-width: var(--ascend-maxw);
    margin-inline: auto;
    padding-inline: var(--ascend-pad-inline);
  }
  .ascend-wrap--wide { max-width: var(--ascend-maxw-wide); }

  .ascend-eyebrow {
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--ascend-muted);
    margin: 0 0 1.25rem;
  }

  /* ---------- CTA ---------- */
  .ascend-cta { display: inline-flex; flex-direction: column; gap: 0.6rem; }
  .ascend-cta--block { display: flex; }
  .ascend-cta--block .ascend-cta__link { width: 100%; }

  .ascend-cta__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 52px;
    padding: 0.9rem 1.8rem;
    border-radius: var(--ascend-radius);
    font: inherit;
    font-weight: 650;
    font-size: 1.02rem;
    line-height: 1.1;
    text-decoration: none;
    text-align: center;
    cursor: pointer;
    transition: transform 120ms ease, background-color 120ms ease, border-color 120ms ease;
  }
  .ascend-cta__link--primary {
    background: var(--ascend-accent);
    color: var(--ascend-accent-ink);
    border: 1px solid var(--ascend-accent);
  }
  .ascend-cta__link--ghost {
    background: transparent;
    color: var(--ascend-ink);
    border: 1px solid var(--ascend-line);
  }
  .ascend-cta__link:hover { transform: translateY(-1px); }
  .ascend-cta__link:active { transform: translateY(0); }
  .ascend-cta__link:focus-visible {
    outline: 3px solid var(--ascend-focus);
    outline-offset: 3px;
  }
  .ascend-cta__subtext {
    font-size: 0.85rem;
    color: var(--ascend-muted);
    text-align: center;
  }

  /* ---------- Editor-only placeholder banner ---------- */
  .ascend-editor-note {
    display: block;
    margin: 1rem 0;
    padding: 0.85rem 1rem;
    border: 1px dashed #E7B24B;
    border-radius: 8px;
    background: rgba(231,178,75,0.08);
    color: #6b5011;
    font-family: var(--ascend-sans);
    font-size: 0.85rem;
    line-height: 1.45;
  }
  .ascend-editor-note__tag {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8a6410;
    margin-bottom: 0.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .ascend-cta__link { transition: none; }
    .ascend-cta__link:hover { transform: none; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Ascend — Design tokens",
  "tag": "section",
  "class": "ascend-tokens",
  "settings": [
    { "type": "header", "content": "Dark / heavy palette (early sections)" },
    { "type": "color", "id": "bg", "label": "Page background", "default": "#0B0D10" },
    { "type": "color", "id": "bg_2", "label": "Alt background", "default": "#101319" },
    { "type": "color", "id": "surface", "label": "Raised panel (dark)", "default": "#161A20" },
    { "type": "color", "id": "ink", "label": "Headings on dark", "default": "#EDF0F3" },
    { "type": "color", "id": "body", "label": "Body text on dark", "default": "#C4CAD3" },
    { "type": "color", "id": "muted", "label": "Muted / labels", "default": "#8C94A0" },
    { "type": "header", "content": "Light / clean palette (Solution onward)" },
    { "type": "color", "id": "surface_light", "label": "Clean surface", "default": "#F5F7F9" },
    { "type": "color", "id": "ink_dark", "label": "Headings on light", "default": "#111820" },
    { "type": "header", "content": "Signal colours" },
    { "type": "color", "id": "loss", "label": "Loss / red register", "default": "#C85248" },
    { "type": "color", "id": "accent", "label": "Ascend accent (green)", "default": "#34B98C" },
    { "type": "color", "id": "focus", "label": "Keyboard focus ring", "default": "#6FB0FF" },
    { "type": "header", "content": "Type" },
    { "type": "text", "id": "font_sans", "label": "Sans stack", "default": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif" },
    { "type": "text", "id": "font_serif", "label": "Serif stack (thought lines)", "default": "Georgia, \"Iowan Old Style\", \"Times New Roman\", serif" }
  ],
  "presets": [{ "name": "Ascend — Design tokens" }]
}
{% endschema %}
